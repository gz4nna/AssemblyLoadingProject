<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      TransDataHelper：多数据库驱动封装类库（ADO.NET 统一接口）。
      作为宿主与所有插件共享的依赖：宿主引用它，插件也引用它（Private=false 不复制），
      从而在插件的 AssemblyLoadContext 解析时回退到宿主已加载的这份拷贝，避免重复携带。
    -->
    <ProjectReference Include="..\..\DataTableCopyScripts\TransDataHelper\TransDataHelper\TransDataHelper.csproj" />

    <!--
      Cronos：Cron 表达式解析库，用于实现"精确时间"调度。
      仅宿主侧调度逻辑使用，插件无需引用。
    -->
    <PackageReference Include="Cronos" Version="0.8.4" />
  </ItemGroup>

</Project>
